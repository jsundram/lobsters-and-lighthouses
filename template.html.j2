<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ title_meta }}</title>

<!-- Add-to-Home-Screen / PWA polish (iOS + Android) -->
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="{{ cfg.trip.short_label }}">
<meta name="application-name" content="{{ cfg.trip.short_label }}">
<meta name="theme-color" content="#1c3a5e">
<meta name="description" content="{{ cfg.trip.description }} {{ date_long }}.">

{# Rich link previews when the URL is texted (iMessage, Google Messages/RCS,
   WhatsApp, Signal, Slack, etc). og:image must be an absolute https URL —
   iMessage's link-preview scraper rejects relative paths. #}
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ cfg.trip.title }}">
<meta property="og:title" content="{{ cfg.trip.title }} · {{ date_long }}">
<meta property="og:description" content="{{ cfg.trip.description }}">
<meta property="og:url" content="{{ cfg.trip.site_url }}/">
<meta property="og:image" content="{{ cfg.trip.site_url }}/preview.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ cfg.trip.title }} — {{ date_long }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ cfg.trip.title }} · {{ date_long }}">
<meta name="twitter:description" content="{{ cfg.trip.description }}">
<meta name="twitter:image" content="{{ cfg.trip.site_url }}/preview.png">
<link rel="canonical" href="{{ cfg.trip.site_url }}/">

{# Lighthouse touch icon — used in apple-touch-icon and rel=icon. URL-encoded SVG data URI. #}
{% set lighthouse_icon = "data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 512 512'><defs><radialGradient id='bg' cx='256' cy='200' r='350' gradientUnits='userSpaceOnUse'><stop offset='0' stop-color='%23fbecd0'/><stop offset='1' stop-color='%23c4a47a'/></radialGradient><radialGradient id='glow' cx='256' cy='140' r='110' gradientUnits='userSpaceOnUse'><stop offset='0' stop-color='%23fff7d0' stop-opacity='0.9'/><stop offset='1' stop-color='%23d99845' stop-opacity='0'/></radialGradient></defs><rect width='512' height='512' fill='url(%23bg)'/><circle cx='256' cy='140' r='130' fill='url(%23glow)'/><g stroke='%23d99845' stroke-width='6' stroke-linecap='round' opacity='0.5'><path d='M256 140 L 80 70'/><path d='M256 140 L 432 70'/><path d='M256 132 L 50 132'/><path d='M256 132 L 462 132'/><path d='M256 142 L 110 30'/><path d='M256 142 L 402 30'/></g><path d='M40 470 Q 130 445 220 460 Q 256 445 292 460 Q 382 445 472 470 L 472 480 L 40 480 Z' fill='%232f5d4a' opacity='0.85'/><rect x='180' y='420' width='152' height='42' rx='3' fill='%237a6b50' stroke='%233a2e1f' stroke-width='3.5' stroke-linejoin='round'/><path d='M196 420 L 212 195 L 300 195 L 316 420 Z' fill='%23fbf6ea' stroke='%233a2e1f' stroke-width='4' stroke-linejoin='round'/><path d='M211 235 L 301 235 L 305 270 L 207 270 Z' fill='%23b8412e'/><path d='M205 320 L 307 320 L 311 355 L 201 355 Z' fill='%23b8412e'/><path d='M242 395 L 242 420 L 270 420 L 270 395 Q 256 384 242 395 Z' fill='%233a2e1f'/><rect x='194' y='178' width='124' height='20' rx='2' fill='%237a6b50' stroke='%233a2e1f' stroke-width='3' stroke-linejoin='round'/><line x1='208' y1='178' x2='208' y2='195' stroke='%233a2e1f' stroke-width='2'/><line x1='256' y1='178' x2='256' y2='195' stroke='%233a2e1f' stroke-width='2'/><line x1='304' y1='178' x2='304' y2='195' stroke='%233a2e1f' stroke-width='2'/><rect x='218' y='128' width='76' height='52' fill='%23fff7d0' stroke='%233a2e1f' stroke-width='4'/><line x1='256' y1='128' x2='256' y2='180' stroke='%233a2e1f' stroke-width='2.5'/><line x1='218' y1='154' x2='294' y2='154' stroke='%233a2e1f' stroke-width='2'/><circle cx='256' cy='154' r='18' fill='%23fff' opacity='0.95'/><circle cx='256' cy='154' r='10' fill='%23fff7d0'/><path d='M210 128 Q 256 74 302 128 Z' fill='%23b8412e' stroke='%233a2e1f' stroke-width='4' stroke-linejoin='round'/><line x1='256' y1='74' x2='256' y2='46' stroke='%233a2e1f' stroke-width='4' stroke-linecap='round'/><circle cx='256' cy='42' r='6' fill='%233a2e1f'/></svg>" %}
<link rel="apple-touch-icon" href="{{ lighthouse_icon | safe }}">
<link rel="icon" type="image/svg+xml" href="{{ lighthouse_icon | safe }}">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,700;9..144,900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  /* JetBrains Mono is embedded inline (vs loaded via Google Fonts) so that
     Chromium's PDF backend renders it correctly inside SVG <text> elements
     — the CDN-loaded version sporadically falls back to a system mono in
     PDF output. */
  {{ jbm_css }}
  /* Application styles live in style.css; build.py inlines them here so the
     output remains a single self-contained HTML file. */
  {{ style_css }}
</style>
</head>
<body>

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>

    <!-- CAR / Tesla-ish SUV silhouette -->
    <symbol id="i-car" viewBox="0 0 48 48">
      <ellipse cx="24" cy="38" rx="19" ry="1" fill="currentColor" opacity="0.18"/>
      <path d="M5 28 V 25.5 C 5 24, 6.2 23, 7.8 22.8 L 11 17.5 C 12 15.5, 13.7 14.5, 15.9 14.5 H 32.1 C 34.3 14.5, 36 15.5, 37 17.5 L 40.2 22.8 C 41.8 23, 43 24, 43 25.5 V 28 C 43 29.4, 42 30.3, 40.7 30.3 H 37.5 M 13 30.3 H 7.3 C 6 30.3, 5 29.4, 5 28 Z"
            fill="currentColor" fill-opacity="0.16" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
      <path d="M11.5 22.5 L 14.5 17 H 33.5 L 36.5 22.5 Z" fill="currentColor" fill-opacity="0.32"/>
      <line x1="24" y1="17" x2="24" y2="22.5" stroke="currentColor" stroke-width="1.2" opacity="0.55"/>
      <line x1="24" y1="22.5" x2="24" y2="28" stroke="currentColor" stroke-width="1" opacity="0.4"/>
      <!-- Tesla 'T' suggestion on hood -->
      <circle cx="14" cy="30.5" r="4.8" fill="currentColor"/>
      <circle cx="14" cy="30.5" r="2" fill="#fbf6ea"/>
      <circle cx="14" cy="30.5" r="0.9" fill="currentColor"/>
      <circle cx="34" cy="30.5" r="4.8" fill="currentColor"/>
      <circle cx="34" cy="30.5" r="2" fill="#fbf6ea"/>
      <circle cx="34" cy="30.5" r="0.9" fill="currentColor"/>
    </symbol>

    <!-- LOBSTER -->
    <symbol id="i-lobster" viewBox="0 0 48 48">
      <!-- antennae -->
      <path d="M20 15 Q 14 7 8 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/>
      <path d="M28 15 Q 34 7 40 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/>
      <!-- left claw -->
      <path d="M6 22 Q 2 21 3 26 Q 4.5 31 11 30 Q 14 27.5 12 24 Q 8.5 20 6 22 Z"
            fill="currentColor" fill-opacity="0.22" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
      <path d="M6.5 25 L 10.5 27" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" opacity="0.7"/>
      <path d="M11.5 27 L 17.5 24.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
      <!-- right claw -->
      <path d="M42 22 Q 46 21 45 26 Q 43.5 31 37 30 Q 34 27.5 36 24 Q 39.5 20 42 22 Z"
            fill="currentColor" fill-opacity="0.22" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
      <path d="M41.5 25 L 37.5 27" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" opacity="0.7"/>
      <path d="M36.5 27 L 30.5 24.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
      <!-- head / cephalothorax -->
      <ellipse cx="24" cy="21" rx="6.5" ry="5.2" fill="currentColor" fill-opacity="0.22" stroke="currentColor" stroke-width="2"/>
      <circle cx="21.5" cy="20" r="0.9" fill="currentColor"/>
      <circle cx="26.5" cy="20" r="0.9" fill="currentColor"/>
      <!-- abdomen segments -->
      <path d="M18.5 26.5 Q 24 29 29.5 26.5 L 29.2 30 Q 24 31.5 18.8 30 Z"
            fill="currentColor" fill-opacity="0.22" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
      <path d="M19 30 Q 24 32 29 30 L 28.7 33.5 Q 24 35 19.3 33.5 Z"
            fill="currentColor" fill-opacity="0.22" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
      <!-- tail fan -->
      <path d="M19.5 34 Q 24 44.5 28.5 34 Z"
            fill="currentColor" fill-opacity="0.25" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
      <path d="M22 36.5 L 20.8 42" stroke="currentColor" stroke-width="1.2" opacity="0.75"/>
      <path d="M24 36.5 V 43" stroke="currentColor" stroke-width="1.2" opacity="0.75"/>
      <path d="M26 36.5 L 27.2 42" stroke="currentColor" stroke-width="1.2" opacity="0.75"/>
    </symbol>

    <!-- LIGHTHOUSE / Maine-style striped -->
    <symbol id="i-lighthouse" viewBox="0 0 48 48">
      <!-- light beams -->
      <path d="M14 13 L 5 10" stroke="currentColor" stroke-width="1.8" opacity="0.42" stroke-linecap="round"/>
      <path d="M14 16 L 5 17" stroke="currentColor" stroke-width="1.8" opacity="0.32" stroke-linecap="round"/>
      <path d="M34 13 L 43 10" stroke="currentColor" stroke-width="1.8" opacity="0.42" stroke-linecap="round"/>
      <path d="M34 16 L 43 17" stroke="currentColor" stroke-width="1.8" opacity="0.32" stroke-linecap="round"/>
      <!-- rocky base -->
      <path d="M6 44 Q 12 42 16 43 Q 20 41 24 42 Q 28 41 32 43 Q 36 42 42 44 Z"
            fill="currentColor" fill-opacity="0.25" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <!-- foundation -->
      <rect x="15" y="38" width="18" height="4" rx="0.5"
            fill="currentColor" fill-opacity="0.22" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
      <!-- main tapered tower -->
      <path d="M17 38 L 19 19 H 29 L 31 38 Z"
            fill="currentColor" fill-opacity="0.14" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
      <!-- horizontal red stripe (filled band) -->
      <path d="M18.2 27.5 L 29.8 27.5 L 30.1 31.5 L 17.9 31.5 Z" fill="currentColor" fill-opacity="0.55"/>
      <!-- another thin stripe -->
      <path d="M18.6 34 L 29.4 34 L 29.5 35.5 L 18.5 35.5 Z" fill="currentColor" fill-opacity="0.35"/>
      <!-- gallery walkway -->
      <rect x="16" y="16" width="16" height="3" rx="0.4"
            fill="currentColor" fill-opacity="0.28" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
      <!-- railing posts -->
      <line x1="19" y1="16" x2="19" y2="19" stroke="currentColor" stroke-width="0.9" opacity="0.55"/>
      <line x1="24" y1="16" x2="24" y2="19" stroke="currentColor" stroke-width="0.9" opacity="0.55"/>
      <line x1="29" y1="16" x2="29" y2="19" stroke="currentColor" stroke-width="0.9" opacity="0.55"/>
      <!-- lantern room -->
      <rect x="19.5" y="9" width="9" height="7" rx="0.5"
            fill="currentColor" fill-opacity="0.32" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
      <line x1="24" y1="9" x2="24" y2="16" stroke="currentColor" stroke-width="0.9" opacity="0.65"/>
      <line x1="19.5" y1="12.5" x2="28.5" y2="12.5" stroke="currentColor" stroke-width="0.9" opacity="0.65"/>
      <!-- dome cap -->
      <path d="M19 9 Q 24 4 29 9 Z"
            fill="currentColor" fill-opacity="0.3" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
      <!-- finial -->
      <line x1="24" y1="4.5" x2="24" y2="2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      <circle cx="24" cy="2.2" r="0.9" fill="currentColor"/>
    </symbol>

    <!-- WALKER / hiker with backpack -->
    <symbol id="i-walk" viewBox="0 0 48 48">
      <!-- subtle ground line -->
      <path d="M6 44 H 42" stroke="currentColor" stroke-width="1.4" opacity="0.35" stroke-dasharray="2 3"/>
      <!-- head -->
      <circle cx="27" cy="7" r="3.6" fill="currentColor" fill-opacity="0.26" stroke="currentColor" stroke-width="2"/>
      <!-- backpack -->
      <path d="M22 14 L 18 17 L 18 27 L 23 28 Z"
            fill="currentColor" fill-opacity="0.32" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
      <path d="M20 19 L 22 20" stroke="currentColor" stroke-width="1" opacity="0.6"/>
      <path d="M20 23 L 22 24" stroke="currentColor" stroke-width="1" opacity="0.6"/>
      <!-- torso -->
      <path d="M27 11 L 24 17 L 22 25 L 27 32 L 28 42"
            stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
      <!-- front arm with stick -->
      <path d="M25 17 L 32 21 L 34 30"
            stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
      <!-- back arm -->
      <path d="M24 17 L 20 22"
            stroke="currentColor" stroke-width="2.2" stroke-linecap="round" fill="none"/>
      <!-- back leg -->
      <path d="M22 25 L 17 32 L 15 42"
            stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
      <!-- shoes -->
      <ellipse cx="15" cy="42.5" rx="3" ry="1.1" fill="currentColor"/>
      <ellipse cx="28" cy="42.5" rx="3" ry="1.1" fill="currentColor"/>
    </symbol>

    <!-- BIRD / coastal gulls in flight -->
    <symbol id="i-bird" viewBox="0 0 48 48">
      <!-- main bird wing M -->
      <path d="M3 24 C 9 14, 17 13, 24 21 C 31 13, 39 14, 45 24"
            stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
      <!-- inner wing details -->
      <path d="M8 22 C 12 17, 16 17, 20 22"
            stroke="currentColor" stroke-width="1.6" stroke-linecap="round" opacity="0.5" fill="none"/>
      <path d="M28 22 C 32 17, 36 17, 40 22"
            stroke="currentColor" stroke-width="1.6" stroke-linecap="round" opacity="0.5" fill="none"/>
      <!-- body -->
      <path d="M22 22 Q 24 26 26 22 L 24.5 24" fill="currentColor" fill-opacity="0.4"/>
      <!-- distant smaller bird left -->
      <path d="M6 34 C 9 31, 12 31, 15 34" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" opacity="0.65"/>
      <!-- distant bird right -->
      <path d="M33 32 C 36 29, 39 29, 42 32" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" opacity="0.65"/>
      <!-- tiny bird center -->
      <path d="M19 38 C 21 36.5, 23 36.5, 25 38 C 27 36.5, 29 36.5, 31 38"
            stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none" opacity="0.5"/>
    </symbol>

    <!-- ICE CREAM CONE / triple scoop with waffle -->
    <symbol id="i-icecream" viewBox="0 0 48 48">
      <!-- cherry stem -->
      <path d="M24 3 Q 26 1 28 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none"/>
      <!-- cherry -->
      <circle cx="24" cy="4" r="1.6" fill="currentColor"/>
      <!-- top scoop -->
      <circle cx="24" cy="9" r="5" fill="currentColor" fill-opacity="0.4" stroke="currentColor" stroke-width="2"/>
      <!-- middle left scoop -->
      <circle cx="18" cy="14" r="5.5" fill="currentColor" fill-opacity="0.32" stroke="currentColor" stroke-width="2"/>
      <!-- middle right scoop -->
      <circle cx="30" cy="14" r="5.5" fill="currentColor" fill-opacity="0.32" stroke="currentColor" stroke-width="2"/>
      <!-- bottom scoop wrap -->
      <circle cx="24" cy="17" r="6.5" fill="currentColor" fill-opacity="0.26" stroke="currentColor" stroke-width="2"/>
      <!-- scoop highlight detail -->
      <path d="M22 7 Q 24 6 26 7" stroke="currentColor" stroke-width="1" opacity="0.5" fill="none" stroke-linecap="round"/>
      <!-- cone -->
      <path d="M15 22 L 24 44 L 33 22 Z"
            fill="currentColor" fill-opacity="0.18" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
      <!-- waffle pattern: horizontal -->
      <line x1="17" y1="26" x2="20.5" y2="26" stroke="currentColor" stroke-width="0.9" opacity="0.55"/>
      <line x1="22" y1="26" x2="25.5" y2="26" stroke="currentColor" stroke-width="0.9" opacity="0.55"/>
      <line x1="27" y1="26" x2="31" y2="26" stroke="currentColor" stroke-width="0.9" opacity="0.55"/>
      <line x1="19" y1="31" x2="29" y2="31" stroke="currentColor" stroke-width="0.9" opacity="0.55"/>
      <line x1="21" y1="36" x2="27" y2="36" stroke="currentColor" stroke-width="0.9" opacity="0.55"/>
      <!-- waffle pattern: diagonal -->
      <line x1="18.5" y1="24" x2="22" y2="42" stroke="currentColor" stroke-width="0.7" opacity="0.4"/>
      <line x1="29.5" y1="24" x2="26" y2="42" stroke="currentColor" stroke-width="0.7" opacity="0.4"/>
    </symbol>

    <!-- LIGHTNING / EV charging bolt -->
    <symbol id="i-bolt" viewBox="0 0 48 48">
      <!-- outer shape -->
      <path d="M28 3 L 9 26 H 21 L 17 45 L 39 21 H 26 L 28 3 Z"
            fill="currentColor" fill-opacity="0.22" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/>
      <!-- inner accent -->
      <path d="M27 9 L 14 24 H 22 L 19.5 38 L 34 22 H 25 L 27 9 Z"
            fill="currentColor" fill-opacity="0.45"/>
      <!-- highlight -->
      <path d="M26 11 L 17 22" stroke="#fbf6ea" stroke-width="1.4" opacity="0.6" stroke-linecap="round"/>
    </symbol>

    <!-- HOUSE / colonial -->
    <symbol id="i-home" viewBox="0 0 48 48">
      <!-- main body -->
      <path d="M6 22 L 24 7 L 42 22 V 42 H 29 V 28 H 19 V 42 H 6 Z"
            fill="currentColor" fill-opacity="0.18" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round"/>
      <!-- chimney -->
      <path d="M31 14.5 V 8.5 H 35.5 V 19.5"
            fill="currentColor" fill-opacity="0.28" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
      <!-- door -->
      <rect x="19" y="28" width="10" height="14"
            fill="currentColor" fill-opacity="0.3" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
      <circle cx="26.5" cy="35" r="0.7" fill="currentColor"/>
      <line x1="24" y1="28" x2="24" y2="42" stroke="currentColor" stroke-width="0.9" opacity="0.55"/>
      <!-- left window -->
      <rect x="9" y="25" width="6.5" height="6.5"
            fill="currentColor" fill-opacity="0.35" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
      <line x1="12.25" y1="25" x2="12.25" y2="31.5" stroke="currentColor" stroke-width="1"/>
      <line x1="9" y1="28.25" x2="15.5" y2="28.25" stroke="currentColor" stroke-width="1"/>
      <!-- right window -->
      <rect x="32.5" y="25" width="6.5" height="6.5"
            fill="currentColor" fill-opacity="0.35" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
      <line x1="35.75" y1="25" x2="35.75" y2="31.5" stroke="currentColor" stroke-width="1"/>
      <line x1="32.5" y1="28.25" x2="39" y2="28.25" stroke="currentColor" stroke-width="1"/>
      <!-- ridge cap line on roof -->
      <line x1="24" y1="7" x2="24" y2="22" stroke="currentColor" stroke-width="1" opacity="0.4"/>
    </symbol>

    <!-- BATTERY SYMBOL (parameterized via fill rect width) -->
    <!-- This is just a template; each stop has its own inline battery svg. -->
  </defs>
</svg>

<div class="page">

  <header class="masthead">
    <div class="mast-left"></div>
    <h1 class="mast-title">Lobsters <span class="amp">&amp;</span> Lighthouses</h1>
    <div class="mast-right">{{ date.strftime("%A") }} · {{ date.strftime("%B") }} {{ date.day }}, {{ date.year }}</div>
  </header>
  <div class="mast-sub">Somerville → Kittery → Ogunquit → Biddeford → Cape Elizabeth → home</div>

  <section class="stats">
    <div class="stat">
      <div><span class="stat-num">10</span><span class="stat-unit">stops</span></div>
      <div class="stat-label">Itinerary</div>
    </div>
    <div class="stat">
      <div><span class="stat-num">255</span><span class="stat-unit">mi</span></div>
      <div class="stat-label">Round trip</div>
    </div>
    <div class="stat">
      <div><span class="stat-num">5:50</span></div>
      <div class="stat-label">Driving</div>
    </div>
    <div class="stat">
      <div><span class="stat-num">6:00</span></div>
      <div class="stat-label">On foot &amp; at table</div>
    </div>
    <div class="stat">
      <div><span class="stat-num">11:50</span></div>
      <div class="stat-label">Door to door</div>
    </div>
  </section>

  <section class="daylight" aria-label="Daylight times for {{ cfg.location.sun_city_name }}">
    <div class="dl-title"><span class="dl-name">Daylight</span><span class="dl-loc">{{ cfg.location.sun_city_name }}</span></div>
    <div class="dl-cells">
      <div class="dl-cell"><span class="lbl">Sunrise</span><span class="val">{{ sun.sunrise }}</span></div>
      <div class="dl-cell"><span class="lbl">Solar noon</span><span class="val">{{ sun.solar_noon }}</span></div>
      <div class="dl-cell"><span class="lbl">Golden hour</span><span class="val">{{ sun.golden_hour }}</span></div>
      <div class="dl-cell"><span class="lbl">Sunset</span><span class="val">{{ sun.sunset }}</span></div>
      <div class="dl-cell"><span class="lbl">Civil dusk</span><span class="val">{{ sun.civil_dusk }}</span></div>
      <div class="dl-cell"><span class="lbl">Day length</span><span class="val">{{ sun.day_length }}</span></div>
    </div>
  </section>

  <section class="tides" aria-label="Tides at {{ cfg.location.tide_station_name }} on {{ date.strftime("%B") }} {{ date.day }}">
    <div class="dl-title"><span class="dl-name">Tides</span><a class="src" href="{{ cfg.location.tide_station_url }}" target="_blank" rel="noopener noreferrer">{{ cfg.location.tide_station_name }}</a></div>
    <div class="tide-vis">{{ tide_svg }}</div>
  </section>

  <div class="section-head">
    <h2>The Itinerary</h2>
  </div>

  {% macro render_stop(stop) %}
  <article class="stop">
    <div class="stop-times">
      <div class="arr">{{ stop.arrival }}</div>
      <div class="dur">{{ stop.duration_label }}</div>
      {% if 'departure' in stop %}
      <div class="dep">→ {{ stop.departure }}</div>
      {% endif %}
      <div class="battery {{ stop.battery.css_class }}">
        <svg viewBox="0 0 26 12"><rect x="0.6" y="0.6" width="20.8" height="10.8" rx="1.6" fill="none" stroke="currentColor" stroke-width="1.1"/><rect x="22" y="3.5" width="2.4" height="5" rx="0.5" fill="currentColor"/><rect x="2" y="2" width="{{ stop.battery.fill_width }}" height="8" rx="0.5" fill="currentColor"/></svg>
        <span class="pct">{{ stop.battery.label }}</span>
      </div>
    </div>
    <div class="stop-body">
      <div class="stop-head">
        <div class="stop-name"><span class="num">{{ stop.id }}</span>{{ stop.name }}</div>
        <span class="stop-icon {{ stop.icon_class }}"><svg><use href="#i-{{ stop.icon }}"/></svg></span>
      </div>
      <div class="stop-addr"><a href="{{ stop.maps_url }}" target="_blank" rel="noopener noreferrer">{{ stop.address_display }}</a></div>
      {% if 'meta' in stop %}
      <div class="stop-meta">
        {% for m in stop.meta %}
        <span><strong>{{ m.label }}</strong> {{ m.value }}</span>
        {% endfor %}
      </div>
      {% endif %}
      <div class="stop-note">
        {{ stop.note }}
        {% if 'restroom' in stop %}<span class="restroom">{{ stop.restroom }}</span>{% endif %}
      </div>
    </div>
    {% if stop.get('leg_distance_label') %}
    <div class="leg"><span>{{ stop.leg_distance_label }}</span><span>{{ stop.leg_route }}</span></div>
    {% endif %}
  </article>
  {% endmacro %}

  <div class="timeline">
    {% for stop in stops %}
    {% if loop.index0 == page_break_at %}
    <div class="page-break" aria-hidden="true">
      <div class="running-header">
        <span class="rh-title">{{ cfg.trip.title }}</span>
        <span class="rh-date">{{ date.strftime("%A, %B") }} {{ date.day }}, {{ date.year }}</span>
        <span class="rh-page">Page 2 / 2</span>
      </div>
    </div>
    {% endif %}
    {{ render_stop(stop) }}
    {% endfor %}
  </div>

  <div class="route-block">
    <div class="route-info">
      <div class="label">Route overview</div>
      <div class="title"><a href="{{ cfg.maps.all_stops_url }}" target="_blank" rel="noopener noreferrer">Google Maps · all ten stops</a></div>
      <div class="meta">Scan or tap the code to open turn-by-turn directions covering the full 255-mile loop, Kittery to Cape Elizabeth and back.</div>
    </div>
    <div class="route-qr"><a href="{{ cfg.maps.all_stops_url }}" target="_blank" rel="noopener noreferrer" aria-label="Open the full route in Google Maps">{{ qr_svg }}</a></div>
  </div>

  <footer class="colophon">
    <span>{{ cfg.trip.title }}</span>
    <span>Prepared for the road · {{ date.strftime("%A") }} {{ date_short }}</span>
  </footer>

</div>

<!-- Web app manifest for Android Chrome "Add to Home Screen". Generated at runtime so the icon stays in one place (the apple-touch-icon link above). iOS reads apple-touch-icon directly; Android reads the manifest. -->
{% autoescape false %}
<script>
(function(){
  try {
    var iconHref = document.querySelector('link[rel="apple-touch-icon"]').href;
    var manifest = {
      name: {{ cfg.trip.short_label | tojson }},
      short_name: {{ cfg.trip.short_label | tojson }},
      description: {{ (cfg.trip.description ~ ' ' ~ date_long ~ '.') | tojson }},
      start_url: '.',
      scope: './',
      display: 'standalone',
      orientation: 'portrait',
      background_color: '#fbf6ea',
      theme_color: '#1c3a5e',
      icons: [
        { src: iconHref, sizes: '512x512', type: 'image/svg+xml', purpose: 'any' },
        { src: iconHref, sizes: 'any',     type: 'image/svg+xml', purpose: 'maskable' }
      ]
    };
    var blob = new Blob([JSON.stringify(manifest)], { type: 'application/manifest+json' });
    var link = document.createElement('link');
    link.rel = 'manifest';
    link.href = URL.createObjectURL(blob);
    document.head.appendChild(link);
  } catch (e) {}
})();
</script>
{% endautoescape %}

</body>
</html>