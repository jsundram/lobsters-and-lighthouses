<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ title_meta }}</title>

<!-- Add-to-Home-Screen / PWA polish (iOS + Android) -->
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="{{ cfg.trip.short_label }}">
<meta name="application-name" content="{{ cfg.trip.short_label }}">
<meta name="theme-color" content="#1c3a5e">
<meta name="description" content="{{ cfg.trip.description }} {{ date_long }}.">

{# Lighthouse touch icon — used in apple-touch-icon and rel=icon. URL-encoded SVG data URI. #}
